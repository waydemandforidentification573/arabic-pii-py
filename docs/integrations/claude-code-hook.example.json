{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "apii hook --client claude --tenant org-a --vault /private/apii/org-a.vault",
            "timeout": 30,
            "statusMessage": "Redacting PII from tool output"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "apii hook --client claude --tenant org-a --vault /private/apii/org-a.vault",
            "timeout": 30,
            "statusMessage": "Restoring real values before write"
          }
        ]
      }
    ]
  }
}
